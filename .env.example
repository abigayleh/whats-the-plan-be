# Supabase pooled connection (Transaction mode, port 6543) — used at runtime
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Supabase direct connection (port 5432) — used by Prisma Migrate
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
PORT=4000
CORS_ORIGIN="http://localhost:5173"
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"
# Error reporting. Unset (as in tests and local dev) disables Sentry entirely.
SENTRY_DSN=""
