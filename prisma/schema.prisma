generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String                    @id @default(uuid())
  email         String                    @unique
  name          String?
  passwordHash  String
  emailVerified Boolean                   @default(false)
  memberships   GroupMember[]
  conversations ConversationParticipant[]
  refreshTokens RefreshToken[]
  assignedTasks Task[]                    @relation("TaskAssignee")
  createdAt     DateTime                  @default(now())
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Group {
  id            String         @id @default(uuid())
  name          String
  members       GroupMember[]
  inviteCodes   InviteCode[]
  events        Event[]
  lists         List[]
  polls         Poll[]
  itineraries   Itinerary[]
  conversations Conversation[]
  pages         Page[]
  createdAt     DateTime       @default(now())
}

model GroupMember {
  userId   String
  groupId  String
  role     Role     @default(MEMBER)
  color    String?
  user     User     @relation(fields: [userId], references: [id])
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())

  @@id([userId, groupId])
}

model InviteCode {
  id        String    @id @default(uuid())
  code      String    @unique
  groupId   String
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  expiresAt DateTime?
  revoked   Boolean   @default(false)
  createdAt DateTime  @default(now())
}

model Event {
  id             String     @id @default(uuid())
  title          String
  description    String?
  startAt        DateTime
  endAt          DateTime
  colorLabel     String?
  createdById    String
  groupId        String?
  group          Group?     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  recurrenceRule Json?
  subtasks       Json? // [{ id, title, done }] — always edited as a whole with the event
  itineraryId    String?
  itinerary      Itinerary? @relation(fields: [itineraryId], references: [id], onDelete: SetNull)
  createdAt      DateTime   @default(now())
}

model Itinerary {
  id          String    @id @default(uuid())
  title       String
  destination String?
  description String?
  startDate   DateTime
  endDate     DateTime
  colorLabel  String?
  icon        String? // icon key from the shared content-icon set (same as Pages)
  completedAt DateTime? // null = active; set = shown in the sidebar's Completed group
  createdById String
  groupId     String?
  group       Group?    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  events      Event[]
  lists       List[] // one auto-created list holds the itinerary's to-dos
  createdAt   DateTime  @default(now())
}

model List {
  id                        String     @id @default(uuid())
  name                      String
  ownerId                   String
  groupId                   String?
  group                     Group?     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  itineraryId               String? // set = this list belongs to an itinerary (hidden from the normal Lists view)
  itinerary                 Itinerary? @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  isSystem                  Boolean    @default(false)
  isDefault                 Boolean    @default(false)
  icon                      String?
  color                     String?
  showUnscheduledOnCalendar Boolean    @default(true)
  tasks                     Task[]
  placements                ListPlacement[]
  createdAt                 DateTime        @default(now())
}

// Per-user ordering overlay for the Lists page. A row exists once a user has
// arranged a list; unplaced lists render at the end by createdAt.
model ListPlacement {
  userId    String
  listId    String
  list      List     @relation(fields: [listId], references: [id], onDelete: Cascade)
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@id([userId, listId])
}

model Task {
  id             String       @id @default(uuid())
  listId         String
  list           List         @relation(fields: [listId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  status         TaskStatus   @default(TODO)
  dueDate        DateTime?
  scheduledStart DateTime?
  scheduledEnd   DateTime?
  recurrenceRule Json? // { frequency: 'daily'|'weekly'|'monthly'|'yearly', interval: number }
  completedDates Json? // recurring only: ISO timestamps of occurrences marked done per-day
  subtasks       Json? // [{ id, title, done }] — always edited as a whole with the task
  location       Json? // { label, lat, lng } — a to-do's place, pinned on the itinerary map
  assignedToId   String?
  assignee       User?        @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdById    String
  attachments    Attachment[]
  createdAt      DateTime     @default(now())
}

model Attachment {
  id         String   @id @default(uuid())
  filename   String
  storedPath String
  mimeType   String
  sizeBytes  Int
  uploadedBy String
  taskId     String?
  task       Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  messageId  String?
  message    Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model Poll {
  id          String       @id @default(uuid())
  question    String
  groupId     String
  group       Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdById String
  expiresAt   DateTime?
  options     PollOption[]
  votes       PollVote[]
  createdAt   DateTime     @default(now())
}

model PollOption {
  id     String     @id @default(uuid())
  pollId String
  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  text   String
  votes  PollVote[]
}

model PollVote {
  id           String     @id @default(uuid())
  pollId       String
  poll         Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  pollOptionId String
  pollOption   PollOption @relation(fields: [pollOptionId], references: [id], onDelete: Cascade)
  userId       String
  createdAt    DateTime   @default(now())

  @@unique([pollId, userId])
}

model Conversation {
  id           String                    @id @default(uuid())
  name         String?
  groupId      String?
  group        Group?                    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]
  createdAt    DateTime                  @default(now())
}

model ConversationParticipant {
  userId         String
  conversationId String
  user           User         @relation(fields: [userId], references: [id])
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@id([userId, conversationId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  text           String?
  embed          Json?
  attachments    Attachment[]
  createdAt      DateTime     @default(now())
}

model Page {
  id          String   @id @default(uuid())
  title       String   @default("Untitled")
  icon        String? // emoji or icon key
  content     Json? // TipTap/ProseMirror document JSON
  ownerId     String
  createdById String
  groupId     String?
  group       Group?   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      Page?    @relation("PageTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children    Page[]   @relation("PageTree")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt // Page-only: drives recently-edited sorting
}

enum Role {
  MEMBER
  ADMIN
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}
